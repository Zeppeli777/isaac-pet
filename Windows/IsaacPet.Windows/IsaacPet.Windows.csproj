<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>IsaacPet</AssemblyName>
    <RootNamespace>IsaacPet.Windows</RootNamespace>
    <ApplicationIcon>Assets\IsaacPet.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Description>Isaac Pet - Windows 桌面桌宠（非官方同人项目）</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Assets\**\*.png;Assets\*.png;Assets\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
